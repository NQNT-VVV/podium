# Podium — configuration. Copier en .env et adapter.
# Aucune valeur n'est ecrite en dur dans le code : tout se regle ici.

# --- Obligatoire en production ---------------------------------------------
# Secret du cookie d'identite partage avec les jeux (PODIUM_SSO_SECRET chez eux).
#   openssl rand -hex 32
SSO_SECRET=

# --- Reseau -----------------------------------------------------------------
PORT=3000
METRICS_PORT=9464
# Origine publique : redirection OAuth, cookies Secure. Vide = deduite de la requete.
PUBLIC_URL=
# Domaine du cookie d'identite, pour que les jeux sur les sous-domaines le lisent.
# Ex. `.danwalex.com`. Vide = hote seul (suffit en local : les cookies ignorent le port).
SSO_COOKIE_DOMAIN=

# --- Donnees ----------------------------------------------------------------
DATA_DIR=./data
# DB_PATH=./data/podium.db

# --- Comptes ----------------------------------------------------------------
# Pseudos promus administrateurs a l'inscription (separes par des virgules).
# Le premier compte cree est administrateur dans tous les cas.
ADMIN_PSEUDOS=
SESSION_DAYS=30
SSO_DAYS=30

# --- Connexion --------------------------------------------------------------
# Application OAuth2 : https://discord.com/developers/applications
# Redirection a declarer : {PUBLIC_URL}/api/auth/discord/callback
# Des que les deux valeurs sont renseignees, Discord est la seule facon de se
# connecter : la connexion par pseudo et mot de passe est fermee.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Identifiants utilisateur Discord (snowflakes) administrateurs, separes par des virgules.
ADMIN_DISCORD_IDS=
# Forcer la connexion par mot de passe meme avec Discord (deconseille en production).
# Sans Discord, elle est active d'office : c'est le mode de developpement.
PASSWORD_LOGIN=

# --- Saisons, semaines et jours ---------------------------------------------
TIME_ZONE=Europe/Paris

# --- Classement -------------------------------------------------------------
RATING_START=1000
RATING_K_PLACEMENT=40
RATING_K=24
RATING_K_HIGH=16
RATING_PLACEMENT_MATCHES=3

# --- Divers -----------------------------------------------------------------
SCHEDULER_S=300
LOGIN_ATTEMPTS=20
LOGIN_WINDOW_S=900
