{
  "name": "podium",
  "version": "0.1.0",
  "private": true,
  "description": "Podium — le hub des jeux : comptes, classement Elo, defis hebdo et quotidiens, catalogue des jeux.",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node.js",
    "predev": "node scripts/check-node.js",
    "dev": "node --watch-path=./server --watch-preserve-output server/index.js",
    "prestart": "node scripts/check-node.js",
    "start": "NODE_ENV=production node server/index.js",
    "prebuild": "node scripts/check-node.js",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:rating": "node test/rating.mjs",
    "test:periods": "node test/periods.mjs",
    "test:auth": "node test/auth-modes.mjs",
    "test:offboarding": "node test/offboarding.mjs",
    "test:community": "node test/community.mjs",
    "pretest": "node scripts/check-node.js",
    "test": "node test/e2e.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.19.2",
    "next": "^15.5.24",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  }
}
